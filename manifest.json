{
  "manifest_version": 3,
  "name": "ResponseRewriter",
  "version": "0.1.0",
  "description": "Intercepts XHR/fetch responses in the page context and rewrites them with configurable rules.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "ResponseRewriter"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
