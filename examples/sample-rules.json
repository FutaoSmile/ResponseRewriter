[
  {
    "id": "rule-profile-001",
    "enabled": true,
    "name": "改写用户信息接口",
    "match": {
      "method": "GET",
      "urlMode": "exact",
      "url": "/api/user/profile"
    },
    "rewrite": {
      "mode": "replace",
      "body": "{\n  \"nickname\": \"mocked-by-extension\"\n}"
    },
    "stats": {
      "hitCount": 0,
      "lastMatchedAt": "",
      "lastMatchedUrl": "",
      "lastResourceType": ""
    }
  },
  {
    "id": "rule-config-002",
    "enabled": true,
    "name": "直接返回本地配置",
    "match": {
      "method": "GET",
      "urlMode": "exact",
      "url": "/api/config"
    },
    "rewrite": {
      "mode": "mock-fetch",
      "body": "{\n  \"debug\": true,\n  \"source\": \"local\"\n}"
    },
    "stats": {
      "hitCount": 0,
      "lastMatchedAt": "",
      "lastMatchedUrl": "",
      "lastResourceType": ""
    }
  }
]
